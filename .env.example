# LLM provider: set ONE key. Without any key the app runs in retrieval-only mode.
# LLM_PROVIDER=auto picks whichever key is set (Anthropic first if both).
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Models (see README "Decisions" for why these defaults)
XAI_GENERATION_MODEL=grok-4
XAI_REWRITE_MODEL=grok-3-mini
GENERATION_MODEL=claude-opus-5-5
GENERATION_EFFORT=low
REWRITE_MODEL=claude-haiku-5-5

# Retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MIN_SIMILARITY=0.50
TOP_K=6

# Hosting
# ACCESS_PASSWORD=            # set to require a password (HTTP basic auth, any user name)
# LOAD_SAMPLES_ON_START=true  # re-index sample_docs on boot (for hosts with an ephemeral disk)
